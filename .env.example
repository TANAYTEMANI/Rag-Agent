# ── Required ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
JINA_API_KEY=jina_...

# ── Infrastructure (defaults match docker-compose.yml) ────────────────────
POSTGRES_URL=postgresql+asyncpg://rag:rag@localhost:5432/ragdb
REDIS_URL=redis://localhost:6379/0
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=your-key-here   # uncomment for Qdrant Cloud deployment

# ── Models ────────────────────────────────────────────────────────────────
ENRICHMENT_MODEL=claude-haiku-4-5-20251001
GENERATION_MODEL=claude-sonnet-4-6
JINA_EMBED_MODEL=jina-embeddings-v3
JINA_IMAGE_MODEL=jina-embeddings-v4
JINA_RERANK_MODEL=jina-reranker-v3
EMBED_DIMENSIONS=1024

# ── Retrieval tuning ──────────────────────────────────────────────────────
TOP_K_RETRIEVAL=20
TOP_N_RERANKED=5
RERANKER_SCORE_THRESHOLD=0.3
SEMANTIC_CACHE_THRESHOLD=0.95

# ── Ingestion ─────────────────────────────────────────────────────────────
CHUNK_BATCH_SIZE=20
TABLE_STORE_DIR=./table_store
UPLOAD_DIR=./uploads

# ── Optional ──────────────────────────────────────────────────────────────
# HF_TOKEN=hf_...  # only needed for local model downloads
