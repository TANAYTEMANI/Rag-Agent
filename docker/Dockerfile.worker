FROM python:3.11-slim

WORKDIR /app
ENV PYTHONPATH=/app

# Only needs poppler (for pdf2image PNG rendering) — no OCR, no Tesseract, no torch
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils curl \
    && rm -rf /var/lib/apt/lists/*

# Install all deps from the single requirements.txt
# pypdf + pdf2image are lightweight; no torch, no docling, no 600MB download
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir -r requirements.txt

COPY . .
